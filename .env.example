# Copy this file to .env and set your API key.
OPENAI_API_KEY=your_api_key_here

# LangChain model string. Change to another supported model if desired.
MODEL=openai:gpt-5-nano

# A2A service addresses (on the same machine)
TRIAGE_AGENT_URL=http://127.0.0.1:8001
SOLUTION_AGENT_URL=http://127.0.0.1:8002
